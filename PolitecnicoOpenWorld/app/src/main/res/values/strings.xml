    <!-- Vida universitaria: GUIONES de plática coherentes (líneas alternadas A/B/A/B) -->
    <string name="amb_convo1_1">¿Cómo te fue en el parcial de mate?</string>
    <string name="amb_convo1_2">Reprobé… el profe puso temas que ni vimos.</string>
    <string name="amb_convo1_3">Igual yo. ¿Vamos a asesorías mañana?</string>
    <string name="amb_convo1_4">Va. Dicen que el de quinto piso explica bien.</string>
    <string name="amb_convo2_1">¿Ya tienen tema para el TT?</string>
    <string name="amb_convo2_2">Algo de visión por computadora, pero mi asesor no contesta.</string>
    <string name="amb_convo2_3">Cámbiale de asesor antes del registro.</string>
    <string name="amb_convo2_4">Ya es tarde… ni modo, a perseguirlo por los pasillos.</string>
